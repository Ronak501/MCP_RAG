{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Surveillance System Camera Configuration",
  "description": "Configuration schema for Autonomous Surveillance Intelligence System",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "description": "List of video sources to monitor",
      "items": {
        "type": "object",
        "required": ["source_id", "source_path", "source_type"],
        "properties": {
          "source_id": {
            "type": "string",
            "description": "Unique identifier for this camera/source",
            "pattern": "^[a-zA-Z0-9_]+$",
            "examples": ["camera_main_entrance", "parking_lot_1"]
          },
          "source_path": {
            "type": "string",
            "description": "Path or URL to the video source",
            "examples": [
              "/path/to/video.mp4",
              "rtsp://192.168.1.100:554/stream",
              "http://192.168.1.100:8080/video.mjpeg",
              "0"
            ]
          },
          "source_type": {
            "type": "string",
            "description": "Type of video source",
            "enum": ["file", "rtsp", "http", "device"],
            "examples": ["file", "rtsp", "http", "device"]
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this source is enabled",
            "default": true
          },
          "location": {
            "type": "string",
            "description": "Human-readable location name",
            "examples": ["Main Entrance", "Parking Lot", "Corridor"]
          },
          "zone": {
            "type": "string",
            "description": "Zone identifier for zone-based processing",
            "examples": ["entrance", "parking", "corridor", "default"]
          },
          "fps": {
            "type": "integer",
            "description": "Frames per second",
            "default": 30,
            "minimum": 1,
            "maximum": 60
          },
          "resolution": {
            "type": "array",
            "description": "[width, height] resolution for processing",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840
            },
            "default": [1280, 720],
            "examples": [[1280, 720], [1920, 1080], [640, 480]]
          },
          "stride": {
            "type": "integer",
            "description": "Process every Nth frame (e.g., 30 = process 1 in 30 frames)",
            "default": 30,
            "minimum": 1,
            "maximum": 300
          },
          "confidence_threshold": {
            "type": "number",
            "description": "Confidence threshold for event detection",
            "default": 0.5,
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "global_settings": {
      "type": "object",
      "description": "Global configuration settings",
      "properties": {
        "api_port": {
          "type": "integer",
          "description": "Port for REST API server",
          "default": 5000
        },
        "api_host": {
          "type": "string",
          "description": "Host address for API server",
          "default": "0.0.0.0"
        },
        "alert_history_size": {
          "type": "integer",
          "description": "Maximum alerts to keep in memory",
          "default": 1000
        },
        "enable_dashboard": {
          "type": "boolean",
          "description": "Enable web dashboard",
          "default": true
        }
      }
    }
  },
  "examples": [
    {
      "sources": [
        {
          "source_id": "camera_entrance",
          "source_path": "data/ucf_crime/Arrest/Arrest001_x264.mp4",
          "source_type": "file",
          "location": "Main Entrance",
          "zone": "entrance",
          "enabled": true,
          "stride": 30,
          "confidence_threshold": 0.5
        },
        {
          "source_id": "camera_parking",
          "source_path": "rtsp://192.168.1.100:554/stream",
          "source_type": "rtsp",
          "location": "Parking Lot",
          "zone": "parking",
          "enabled": true,
          "stride": 60,
          "confidence_threshold": 0.6
        },
        {
          "source_id": "camera_corridor",
          "source_path": "0",
          "source_type": "device",
          "location": "Corridor",
          "zone": "corridor",
          "enabled": false
        }
      ],
      "global_settings": {
        "api_port": 5000,
        "alert_history_size": 1000,
        "enable_dashboard": true
      }
    }
  ]
}
